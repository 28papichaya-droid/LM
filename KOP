-- Player
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()

-- ScreenGui
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "ThaiHubGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = player:WaitForChild("PlayerGui")

-- หน้า UI หลัก
local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 200, 0, 120)
mainFrame.Position = UDim2.new(0, 50, 0, 50)
mainFrame.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
mainFrame.BackgroundTransparency = 0.2
mainFrame.Parent = screenGui
mainFrame.Visible = true

-- ชื่อ UI
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 40)
title.Position = UDim2.new(0, 0, 0, 0)
title.Text = "คนไทย 🇹🇭"
title.TextColor3 = Color3.new(1, 1, 1)
title.BackgroundTransparency = 1
title.TextScaled = true
title.Parent = mainFrame

-- ปุ่มเปิด UI
local openCircle = Instance.new("TextButton")
openCircle.Size = UDim2.new(0, 50, 0, 50)
openCircle.Position = UDim2.new(0, 50, 0, 50)
openCircle.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
openCircle.Text = "เปิด"
openCircle.TextScaled = true
openCircle.BorderSizePixel = 0
openCircle.Visible = false
openCircle.Parent = screenGui
openCircle.TextWrapped = true
openCircle.TextStrokeTransparency = 0.5
openCircle.TextStrokeColor3 = Color3.new(0, 0, 0)

-- ปุ่มปิด UI
local toggleButton = Instance.new("TextButton")
toggleButton.Size = UDim2.new(0, 160, 0, 30)
toggleButton.Position = UDim2.new(0, 20, 0, 80)
toggleButton.Text = "ปิด UI"
toggleButton.Parent = mainFrame

toggleButton.MouseButton1Click:Connect(function()
	mainFrame.Visible = false
	openCircle.Visible = true
end)

openCircle.MouseButton1Click:Connect(function()
	mainFrame.Visible = true
	openCircle.Visible = false
end)

-- 🧱 สวิตช์เดินทะลุ
local noclip = false
local noclipSwitch = Instance.new("TextButton")
noclipSwitch.Size = UDim2.new(0, 160, 0, 30)
noclipSwitch.Position = UDim2.new(0, 20, 0, 45)
noclipSwitch.Text = "เดินทะลุ: ปิด"
noclipSwitch.TextColor3 = Color3.new(1, 1, 1)
noclipSwitch.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
noclipSwitch.Parent = mainFrame

-- ฟังก์ชันสลับการใช้งานเดินทะลุ
noclipSwitch.MouseButton1Click:Connect(function()
	noclip = not noclip
	if noclip then
		noclipSwitch.Text = "เดินทะลุ: เปิด"
		noclipSwitch.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
	else
		noclipSwitch.Text = "เดินทะลุ: ปิด"
		noclipSwitch.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
		-- คืนค่าการชนให้ชิ้นส่วนตัวละครเมื่อปิด
		if character then
			for _, part in pairs(character:GetDescendants()) do
				if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
					part.CanCollide = true
				end
			end
		end
	end
end)

-- ระบบเดินทะลุทำงานผ่าน RunService Loop
RunService.Stepped:Connect(function()
	if noclip and character then
		for _, part in pairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
	end
end)

-- อัปเดตตัวละครเมื่อเกิดใหม่
player.CharacterAdded:Connect(function(newChar)
	character = newChar
end)
